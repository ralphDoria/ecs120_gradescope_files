# begin and end: {w ∈ {0, 1}∗ | w begins with 010 and ends with a 0 }

states: 
  - qEmpty # read no characters
  - q0     # read first symbol of prefix
  - q01    # read first 2 symbols of prefix
  - q010   # read prefix & ends in 0 (accept state)
  - qDead  # trap state set when prefix wasn't read
  - q1     # prefix has been read, but doesn't end in 0

input_alphabet: [0, 1]

start_state: qEmpty

accept_states: [q010]

delta:
  qEmpty:
    0: q0
    1: qDead
  q0:
    0: qDead
    1: q01
  q01:
    0: q010
    1: qDead
  q010:
    0: q010
    1: q1
  q1:
    0: q010
    1: q1
  qDead:
    0: qDead
    1: qDead
