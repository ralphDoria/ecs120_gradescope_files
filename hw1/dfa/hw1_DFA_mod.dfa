# mod: {w ∈ {0, 1}∗ | w is the binary expansion of n ∈ N and n ≡ 3 mod 5}. Assume ε represents
# 0 and that leading 0’s are allowed. A number n ∈ N is congruent to 3 mod 5 (written n ≡ 3
# mod 5) if n is 3 greater than a multiple of 5, i.e., n = 5k + 3 for some k ∈ N. For instance,
# 3, 8, and 13 are congruent to 3 mod 5

states:
  - q
  - q0
  - q1
  - q2
  - q3
  - q4

input_alphabet: [0, 1]

start_state: q
accept_states: [q3]

delta:
  q:
    0: q0
    1: q1
  q0:
    0: q0
    1: q1
  q1:
    0: q2
    1: q3
  q2:
    0: q4
    1: q0
  q3:
    0: q1
    1: q2
  q4:
    0: q3
    1: q4
